// AppStoreRelease.xcconfig
// App Store customer distribution configuration (AGENTS.md "Release Channel Policy").
//
// MUST NOT define KIROLE_INTERNAL. Internal/debug UI, behavior, logging,
// factory commands, and test shortcuts are compiled out at the app-target
// boundary. Do not add compilation conditions here without a product decision.
// BLE secure channel is a firmware-readiness switch, not a channel property:
// with BLE_SECURE_CHANNEL_ENABLED = 0 (current) this configuration ships the
// plaintext BLE link the firmware implements and BLE_SHARED_SECRET is blanked;
// only at 1 do device/archive builds and fastlane ios external / appstore fail
// closed on an empty secret (Config/scripts-generate-build-secrets.sh).
// Paired gate: scripts/verify-release-boundary.sh

#include "Release.xcconfig"

// Keep repository-only build, test, and backend setup files out of the
// customer bundle. The files remain available to local tooling and
// InternalRelease is intentionally unchanged.
EXCLUDED_SOURCE_FILE_NAMES = $(inherited) Kirole.xctestplan Secrets.xcconfig.template generate-prompt-spec.py scripts-generate-build-secrets.sh supabase-schema.sql
