// Shared.xcconfig
// Minimal shared configuration for scaffold tool customization
// All other settings use Xcode project defaults
// Generated by XcodeBuildMCP

// ==========================================
// Project Identity
// ==========================================
PRODUCT_NAME = Kirole
PRODUCT_DISPLAY_NAME = Kirole
PRODUCT_BUNDLE_IDENTIFIER = com.kirole.app

// ⚠️ 这两行不是生效值，只是 xcconfig 层的兜底。`Kirole.xcodeproj/project.pbxproj`
// 在每个 target/配置里都显式设了 MARKETING_VERSION 与 CURRENT_PROJECT_VERSION，
// 而 Xcode 的 build settings 优先级高于 xcconfig——**pbxproj 才是真源**。
// 发版工具也印证这一点：fastlane `increment_build_number` 改的是 pbxproj。
// 改版本号请改 pbxproj（App 与 DeviceActivity 扩展各 4 个配置，共 8 处，
// 必须一起改：Apple 要求扩展的 CFBundleShortVersionString 与主 App 一致）。
// 此处保持与 pbxproj 同值，纯粹为了不误导读者——2026-09-03 这里停在 1.0
// 而线上已是 2.0，害人白查了一轮。
MARKETING_VERSION = 2.0.1
CURRENT_PROJECT_VERSION = 1

// ==========================================
// Platform Configuration
// ==========================================
IPHONEOS_DEPLOYMENT_TARGET = 17.0

// (1 == iPhone, 2 == iPad)
TARGETED_DEVICE_FAMILY = 1,2

// ==========================================
// Info PLIST (Build Settings)
// ==========================================
INFOPLIST_KEY_UISupportedInterfaceOrientations = portrait
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad = UIInterfaceOrientationLandscapeRight UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown

// ==========================================
// Code Signing
// ==========================================
// Set your Development Team ID here (required for device deployment)
// Find your Team ID at: https://developer.apple.com/account -> Membership
// DEVELOPMENT_TEAM = YOUR_TEAM_ID

// ==========================================
// Entitlements
// ==========================================
// AI agents can modify Config/Kirole.entitlements to add capabilities
CODE_SIGN_ENTITLEMENTS = Config/Kirole.entitlements

// ==========================================
// Info.plist
// ==========================================
// Custom Info.plist with privacy descriptions and URL schemes
INFOPLIST_FILE = Config/Info.plist
GENERATE_INFOPLIST_FILE = NO

// ==========================================
// Secrets (Optional)
// ==========================================
// Include secrets config if it exists (not committed to git)
// Create Config/Secrets.xcconfig with your API keys
#include? "Secrets.xcconfig"
